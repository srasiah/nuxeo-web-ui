NUXEO_WEB_UI_VERSION=2025.24.0-SNAPSHOT
NUXEO_VERSION=master
# Nuxeo server image for task docker-*; 2023/2025 images live in the private registry
# (podman login docker-private.packages.nuxeo.com), e.g. docker-private.packages.nuxeo.com/nuxeo/nuxeo
NUXEO_IMAGE=nuxeo/nuxeo

REGISTRY_USERNAME=
REGISTRY_PASSWORD=

NUXEO_PACKAGES=nuxeo-drive nuxeo-liveconnect nuxeo-template-rendering
NUXEO_DEV_MODE=true
NUXEO_CLID=

# task deploy: the <server> id in ~/.m2/settings.xml holding the credentials, and where releases and
# -SNAPSHOT versions go (the same URL when the repository takes both)
DISTRIBUTION_ID=
DISTRIBUTION_URL=
DISTRIBUTION_SNAPSHOTS_URL=
# Maven settings (MVN_*): tracked defaults in .env.mvn; set one here to override it. Listed in taskfiles/mvn.yml.

# Compose command for the docker-* tasks (default: podman compose)
COMPOSE=
